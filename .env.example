# Copiar a .env (cp .env.example .env) y cambiar los secretos. Nunca commitear .env.

# --- Base de datos (PostgreSQL) ---
POSTGRES_USER=miniaula
POSTGRES_PASSWORD=cambiar_esto
POSTGRES_DB=miniaula
# localhost para correr la API fuera de Docker; docker-compose lo fuerza a "db".
DB_HOST=localhost
DB_PORT=5432

# --- API ---
API_PORT=3000
# Mínimo 32 caracteres.
JWT_SECRET=cambiar_esto_por_un_secreto_largo
JWT_EXPIRES_IN=2h
# Orígenes permitidos separados por coma (8080 = web en Docker, 5173 = Vite dev).
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# --- Web (Vite la incrusta en el build) ---
VITE_API_URL=http://localhost:3000/api
