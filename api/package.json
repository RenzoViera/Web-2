{
  "name": "miniaula-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de MiniAula",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
